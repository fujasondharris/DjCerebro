# Copy to .env.local (gitignored — see .gitignore's `.env*.local` rule) and
# fill in real values. Never commit .env.local.

# Required — the brain's Claude API key (console.anthropic.com). Without it
# /api/dj cleanly 500s ("ANTHROPIC_API_KEY is not set...").
ANTHROPIC_API_KEY=

# Optional — model id for the brain to call. Defaults to claude-opus-5-5 if
# unset.
ANTHROPIC_MODEL=

# Optional alternative brain provider API keys
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
MUSE_API_KEY=

# M5: Google Drive crate loader. Create a Drive folder, share it "anyone
# with link", and set its id here — the app lists/downloads MP3s from it.
# GOOGLE_DRIVE_FOLDER_ID is required for live Drive listing; with no
# GOOGLE_API_KEY set, the app falls back to the committed
# src/data/crate-manifest.json instead (see README's "Run your own").
GOOGLE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# M5: optional passcode gate for /api/dj and /api/crate*. Leave blank for
# local dev (routes work exactly as before). Set it before a real party/
# deploy so a shared URL isn't wide open.
DJ_PASSCODE=

# M6: optional — enables /api/lessons cross-device lesson-ledger sync. On
# Vercel this is set automatically when you connect a Blob store to the
# project (dashboard → Storage → Blob → Connect); only fill it in here if
# you want lesson sync while running locally.
BLOB_READ_WRITE_TOKEN=
